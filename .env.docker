# Copy to .env and fill in for local dev (docker-compose.dev.yml matches these defaults)

DATABASE_URL=postgresql+psycopg2://stockscout:stockscout@localhost:5432/stockscout
REDIS_URL=redis://localhost:6379/0

# CELERY_ALWAYS_EAGER=true runs scan tasks inline (no worker needed) -- only
# for tests/local debugging. Leave unset (or false) for real usage so scans
# actually go through a Celery worker: celery -A app.celery_app worker
CELERY_ALWAYS_EAGER=false

# Leave as "lax" unless frontend and API are on different origins/domains
# (e.g. deployed as separate Render services) -- see DEPLOY.md.
COOKIE_SAMESITE=lax

# ── Scan tuning (all optional -- sensible defaults if unset) ────────────────
# Set these in Render's Environment tab to tune a live deployment without a
# code change or rebuild. Every one of these used to be a hardcoded constant.

# core/yf_ratelimit.py -- pacing/retry behaviour for every Yahoo Finance call
YF_MIN_DELAY_S=1.1          # minimum pause between Yahoo requests (seconds)
YF_MAX_DELAY_S=3.2          # maximum pause / jitter ceiling (seconds)
YF_MAX_RETRIES=3            # retry attempts per call before giving up on a symbol
YF_BASE_BACKOFF_S=4.0       # base for exponential backoff after a retry
YF_CACHE_TTL_S=3600         # in-process per-symbol cache TTL (seconds)
YF_COOLDOWN_S=35.0          # shared pause across ALL workers/processes after a
                             # 429 or an empty ("silently blocked") response --
                             # also read directly by core/redis_client.py, so
                             # this is the one number that controls both
YF_REQUEST_TIMEOUT_S=15.0   # hard ceiling on any single HTTP call to Yahoo
YF_TICKER_REGISTRY_MAX=30   # max symbols kept in the in-process Ticker cache
YF_MEM_CACHE_MAX=150        # max entries in the in-process data cache

# app/scan_runner.py -- how a scan job itself runs
SCAN_MAX_WORKERS=4          # concurrent fetch threads per scan
SCAN_POLL_INTERVAL_S=3      # how often the scan loop checks for cancel/writes a heartbeat
SCAN_MEMORY_CEILING_MB=420  # RSS (MB) at which a scan stops itself cleanly and
                             # becomes resumable, instead of risking an OS OOM
                             # kill on Render's free-tier 512MB limit
